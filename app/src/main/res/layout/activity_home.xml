<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/surface" tools:ignore="Overdraw">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="16dp"
        android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="22dp">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="match_parent" android:layout_height="48dp">
            <TextView android:id="@+id/app_title" android:text="@string/app_name"
                android:textColor="@color/text_primary" android:textSize="20sp"
                android:fontFamily="sans-serif-medium" android:singleLine="true"
                android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" />
            <TextView android:id="@+id/home_more" android:text="@string/more_menu_symbol" android:textSize="26sp"
                android:contentDescription="@string/settings_description" android:gravity="center" android:textColor="@color/text_primary"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="48dp" android:layout_height="48dp" />
        </LinearLayout>
        <TextView android:text="@string/search_posts_by_id" android:textColor="@color/text_secondary"
            android:textSize="12sp" android:layout_marginTop="2dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="vertical" android:background="@drawable/section_background"
            android:padding="14dp" android:layout_marginTop="18dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="@string/site_5ch" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                android:textColor="@color/accent" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="@string/board_label" android:textColor="@color/text_secondary" android:textSize="12sp"
                android:layout_marginTop="13dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <EditText android:importantForAutofill="no" android:id="@+id/board" android:hint="@string/board_hint_5ch" android:singleLine="true"
                android:inputType="textNoSuggestions" android:background="@drawable/input_background"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_marginTop="5dp"
                android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="46dp" />
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="8dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/choose_board" android:text="@string/choose_board_category" style="@style/HissiSubButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp"/>
                <Button android:id="@+id/add_favorite" android:text="@string/save_favorite" style="@style/HissiSubButton"
                    android:layout_marginStart="6dp" android:layout_width="80dp" android:layout_height="44dp"/>
                <Button android:id="@+id/show_favorites" android:text="@string/favorite_symbol" android:contentDescription="@string/favorites_description"
                    style="@style/HissiSubButton" android:layout_marginStart="6dp" android:layout_width="52dp" android:layout_height="44dp"/>
            </LinearLayout>
            <TextView android:text="@string/search_date_label" android:textColor="@color/text_secondary" android:textSize="12sp"
                android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <Button android:id="@+id/date_summary" android:text="@string/choose_date" android:gravity="center_vertical|start"
                style="@style/HissiSubButton" android:layout_marginTop="5dp"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_width="match_parent" android:layout_height="44dp"/>
            <TextView android:text="@string/id_label" android:textColor="@color/text_secondary" android:textSize="12sp"
                android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <EditText android:importantForAutofill="no" android:id="@+id/user_id" android:hint="@string/id_search_hint" android:singleLine="true"
                android:background="@drawable/input_background" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:layout_marginTop="5dp" android:inputType="textNoSuggestions"
                android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="46dp"/>
            <Button android:id="@+id/search" android:text="@string/search_id_button" style="@style/HissiPrimaryButton"
                android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="46dp" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/section_background"
            android:padding="14dp" android:layout_marginTop="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="@string/site_edge" android:textSize="16sp"
                android:fontFamily="sans-serif-medium" android:textColor="@color/accent"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="@string/board_label" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="13dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:importantForAutofill="no" android:id="@+id/edge_board" android:hint="@string/board_hint_edge"
                android:singleLine="true" android:inputType="textNoSuggestions"
                android:background="@drawable/input_background" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:layout_marginTop="5dp" android:textColor="@color/text_primary"
                android:layout_width="match_parent" android:layout_height="46dp" />
            <TextView android:text="@string/search_date_label" android:textColor="@color/text_secondary"
                android:textSize="12sp" android:layout_marginTop="14dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/edge_date_summary" android:text="@string/choose_date"
                android:gravity="center_vertical|start" style="@style/HissiSubButton"
                android:layout_marginTop="5dp" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:layout_width="match_parent" android:layout_height="44dp" />
            <TextView android:text="@string/id_label" android:textColor="@color/text_secondary"
                android:textSize="12sp" android:layout_marginTop="14dp"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:importantForAutofill="no" android:id="@+id/edge_user_id" android:hint="@string/id_search_hint"
                android:singleLine="true" android:inputType="textNoSuggestions"
                android:background="@drawable/input_background" android:paddingStart="12dp"
                android:paddingEnd="12dp" android:layout_marginTop="5dp" android:textColor="@color/text_primary"
                android:layout_width="match_parent" android:layout_height="46dp" />
            <Button android:id="@+id/edge_search" android:text="@string/search_id_button"
                style="@style/HissiPrimaryButton" android:layout_marginTop="16dp"
                android:layout_width="match_parent" android:layout_height="46dp" />
            <TextView android:text="@string/paste_checker_url" android:textSize="12sp"
                android:layout_marginTop="18dp" android:textColor="@color/text_secondary"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:importantForAutofill="no" android:id="@+id/edge_url" android:hint="@string/edge_url_hint"
                android:inputType="textUri" android:singleLine="false" android:maxLines="2"
                android:background="@drawable/input_background" android:padding="12dp"
                android:layout_marginTop="7dp" android:textSize="14sp" android:textColor="@color/text_primary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"/>
            <Button android:id="@+id/open_edge" android:text="@string/open_url_button" style="@style/HissiSubButton"
                android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="44dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
