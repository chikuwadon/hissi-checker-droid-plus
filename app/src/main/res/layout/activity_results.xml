<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface" tools:ignore="Overdraw">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="8dp" android:layout_width="match_parent" android:layout_height="48dp">
        <TextView android:id="@+id/toolbar_back" android:text="@string/back_symbol" android:textSize="30sp"
            android:gravity="center" android:contentDescription="@string/back_description" android:textColor="@color/text_primary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp" android:layout_height="44dp" />
        <TextView android:id="@+id/toolbar_title" android:text="@string/app_name"
            android:layout_marginStart="8dp" android:ellipsize="end" android:singleLine="true"
            android:textSize="17sp" android:textColor="@color/text_primary" android:layout_weight="1"
            android:layout_width="0dp" android:layout_height="wrap_content" />
        <TextView android:id="@+id/toolbar_more" android:text="@string/more_menu_symbol" android:textSize="24sp"
            android:contentDescription="@string/menu_description" android:gravity="center" android:textColor="@color/text_secondary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="48dp" android:layout_height="48dp" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp"
        android:layout_width="match_parent" android:layout_height="44dp">
        <TextView android:id="@+id/tab_posts" android:text="@string/initial_posts_tab" style="@style/CheckerTab"/>
        <TextView android:id="@+id/tab_threads" android:text="@string/initial_threads_tab" style="@style/CheckerTab"/>
        <TextView android:id="@+id/tab_names" android:text="@string/initial_names_tab" style="@style/CheckerTab"/>
    </LinearLayout>
    <TextView android:id="@+id/status" android:ellipsize="end" android:singleLine="true"
        android:paddingStart="10dp" android:paddingEnd="8dp" android:gravity="center_vertical"
        android:textColor="@color/text_secondary" android:textSize="11sp"
        android:layout_width="match_parent" android:layout_height="24dp" />
    <LinearLayout android:id="@+id/stat_block" android:orientation="vertical"
        android:paddingStart="10dp" android:paddingEnd="10dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone">
        <LinearLayout android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_width="match_parent"
            android:layout_height="32dp">
            <TextView android:id="@+id/stat_summary" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="32dp"
                android:gravity="center_vertical" android:textSize="12sp"
                android:singleLine="true" android:ellipsize="end"
                android:textColor="@color/text_secondary"
                android:contentDescription="@string/chart_toggle_description" />
            <TextView android:id="@+id/edge_analysis_link"
                android:text="@string/analysis_link_label" android:gravity="center"
                android:textColor="@color/accent" android:textSize="12sp"
                android:paddingStart="8dp" android:paddingEnd="6dp"
                android:layout_width="wrap_content" android:minWidth="100dp"
                android:layout_height="32dp" android:visibility="gone"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/analysis_link_description" />
        </LinearLayout>
        <com.chikuwadon.hissidroidplus.HourlyChartView
            android:id="@+id/hourly_chart" android:layout_width="match_parent"
            android:layout_height="64dp" android:visibility="gone" />
    </LinearLayout>
    <ListView android:id="@+id/items" android:fastScrollEnabled="true" android:clipToPadding="false"
        android:paddingStart="3dp" android:paddingEnd="3dp" android:paddingBottom="3dp"
        android:divider="@color/divider" android:dividerHeight="1dp"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
