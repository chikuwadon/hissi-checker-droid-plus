<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp"
    android:paddingTop="5dp" android:paddingBottom="6dp"
    android:background="?android:attr/selectableItemBackground" tools:ignore="Overdraw"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/item_title" android:textIsSelectable="true" android:textColor="@color/accent"
        android:textSize="13sp" android:fontFamily="sans" android:lineSpacingExtra="0dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/item_subtitle" android:textIsSelectable="true" android:textColor="@color/text_secondary"
        android:textSize="11sp" android:fontFamily="sans" android:layout_marginTop="1dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/item_body" android:textIsSelectable="true" android:textColor="@color/text_primary"
        android:textSize="14sp" android:fontFamily="sans" android:layout_marginTop="2dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
