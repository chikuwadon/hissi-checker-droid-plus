<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle">
        <solid android:color="#21404A"/><corners android:radius="11dp"/>
        <stroke android:width="1dp" android:color="#36C7CC"/>
    </shape></item>
    <item><shape android:shape="rectangle">
        <solid android:color="@color/panel"/><corners android:radius="11dp"/>
        <stroke android:width="1dp" android:color="@color/border"/>
    </shape></item>
</selector>
