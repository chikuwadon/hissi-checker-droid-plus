<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Only hissi.org requires compatibility with plain HTTP. -->
    <base-config cleartextTrafficPermitted="false"/>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">hissi.org</domain>
        <domain includeSubdomains="false">www.hissi.org</domain>
    </domain-config>
</network-security-config>
